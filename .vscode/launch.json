{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Full Stack",
            "configurations": [
                "(Server for Full Stack)",
                "(Client for Full Stack)"
            ],
            "preLaunchTask": "fullstack: Build",
            "stopAll": true
        },
        {
            "name": "Desktop App and Local Server",
            "configurations": [
                "Local Server",
                "(Desktop App for Local Server)"
            ],
            "preLaunchTask": "desktop: local: build",
            "stopAll": true
        }
    ],
    "configurations": [
        {
            "name": "Desktop App (Connect to Azure)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "desktop: Build",
            "program": "${workspaceFolder}/src/Desktop/bin/Debug/net10.0-windows/Gambol.Desktop.dll",
            "args": ["--cloud"],
            "cwd": "${workspaceFolder}/src/Desktop",
            "stopAtEntry": false,
            "console": "internalConsole",
            "justMyCode": false
        },
        {
            "name": "(Desktop App for Local Server)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Desktop/bin/Debug/net10.0-windows/Gambol.Desktop.dll",
            "args": ["--local"],
            "cwd": "${workspaceFolder}/src/Desktop",
            "stopAtEntry": false,
            "console": "internalConsole",
            "justMyCode": false
        },
        {
            "name": "Local Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "server: Build",
            "program": "${workspaceFolder}/src/Server/bin/Debug/net10.0/Gambol.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5115"
            }
        },
        {
            "name": "Local Client (Edge)",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "fable: Build Client",
            "url": "http://localhost:5115/ambit",
            "webRoot": "${workspaceFolder}/src/Server/wwwroot",
            "sourceMapPathOverrides": {
                "../../Client/*": "${workspaceFolder}/src/Client/*",
                "../../../Shared/*": "${workspaceFolder}/src/Shared/*"
            }
        },
        {
            "name": "Local Client (Chrome)",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "fable: Build Client",
            "url": "http://localhost:5115/ambit",
            "webRoot": "${workspaceFolder}/src/Server/wwwroot",
            "sourceMapPathOverrides": {
                "../../Client/*": "${workspaceFolder}/src/Client/*",
                "../../../Shared/*": "${workspaceFolder}/src/Shared/*"
            }
        },
        {
            "name": "Azure Client (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "https://collaborative-systems.org/ambit",
            "webRoot": "${workspaceFolder}/src/Server/wwwroot",
            "pathMapping": {
                "/ambit": "${workspaceFolder}/src/Server/wwwroot"
            },
            "sourceMapPathOverrides": {
                "../../Client/*": "${workspaceFolder}/src/Client/*",
                "../../../Shared/*": "${workspaceFolder}/src/Shared/*"
            }
        },
        {
            "name": "Azure Client (Edge)",
            "type": "msedge",
            "request": "launch",
            "url": "https://collaborative-systems.org/ambit",
            "webRoot": "${workspaceFolder}/src/Server/wwwroot",
            "pathMapping": {
                "/ambit": "${workspaceFolder}/src/Server/wwwroot"
            },
            "sourceMapPathOverrides": {
                "../../Client/*": "${workspaceFolder}/src/Client/*",
                "../../../Shared/*": "${workspaceFolder}/src/Shared/*"
            }
        },
        {
            "name": "(Server for Full Stack)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Server/bin/Debug/net10.0/Gambol.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5115"
            }
        },
        {
            "name": "(Client for Full Stack)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5115/ambit",
            "webRoot": "${workspaceFolder}/src/Server/wwwroot",
            "sourceMapPathOverrides": {
                "../../Client/*": "${workspaceFolder}/src/Client/*",
                "../../../Shared/*": "${workspaceFolder}/src/Shared/*"
            }
        }
    ]
}
