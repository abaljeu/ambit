<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PublicTypes.fs" />
    <Compile Include="Internal/CursorTypes.fs" />
    <Compile Include="Internal/CursorHttp.fs" />
    <Compile Include="Internal/CursorModelsFile.fs" />
    <Compile Include="Internal/CursorAdapter.fs" />
    <Compile Include="Internal/GrokBotHttp.fs" />
    <Compile Include="Internal/GrokBotAdapter.fs" />
    <Compile Include="AgentRunnerFake.fs" />
    <Compile Include="GrokBotFake.fs" />
    <Compile Include="AgentRunner.fs" />
    <Compile Include="GrokBotRunner.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="cursor-models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Data" Version="6.4.0" />
  </ItemGroup>

</Project>
