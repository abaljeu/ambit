<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Server\AuthToken.fs" Link="AuthToken.fs" />
    <Compile Include="AuthStore.fs" />
    <Compile Include="FolderPicker.fs" />
    <Compile Include="WorkspaceMappingEndpoints.fs" />
    <Compile Include="WorkspaceDownloadManager.fs" />
    <Compile Include="WorkspaceSyncEndpoints.fs" />
    <Compile Include="LocalProxy.fs" />
    <Compile Include="Desktop.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="Thoth.Json.Newtonsoft" Version="0.3.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Gambol.Shared.fsproj" />
    <ProjectReference Include="..\Shared\dotnet\Gambol.Shared.DotNet.fsproj" />
  </ItemGroup>

</Project>
