<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>a6b5ead7-8f2d-4482-acb0-0232585d7c6e</UserSecretsId>
  </PropertyGroup>

  <!-- Run Fable before publish so deployed wwwroot always has the latest client -->
  <Target Name="BuildFableBeforePublish" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="dotnet fable ..\Client --outDir $(ProjectDir)wwwroot --sourceMaps" WorkingDirectory="$(ProjectDir)" />
    <Exec Command="npm --prefix ../.. run bundle" WorkingDirectory="$(ProjectDir)" />
  </Target>

  <ItemGroup>
    <!-- Prevent dotnet watch from restarting the server when Fable rewrites wwwroot -->
    <Watch Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DataDir.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="AmbitApp.fs" />
    <Compile Include="HttpResponseLog.fs" />
    <Compile Include="GitSave.fs" />
    <Compile Include="WorkspaceGit.fs" />
    <Compile Include="WorkspaceWebDav.fs" />
    <Compile Include="LazyLoadReconciliationDiagnostics.fs" />
    <Compile Include="GitGatewayDiagnostics.fs" />
    <Compile Include="IgnoredDestination.fs" />
    <Compile Include="DocumentPersistence.fs" />
    <Compile Include="Bookkeeping.fs" />
    <Compile Include="EventLogFile.fs" />
    <Compile Include="DailyGitSave.fs" />
    <Compile Include="DocumentLoader.fs" />
    <Compile Include="Core\CoreChanges.fs" />
    <Compile Include="Core\CoreCredentials.fs" />
    <Compile Include="Core\CoreActorPool.fs" />
    <Compile Include="AiKeys.fs" />
    <Compile Include="AiRepos.fs" />
    <Compile Include="AiCommandArgs.fs" />
    <Compile Include="GrokBotSettings.fs" />
    <Compile Include="TestActor.fs" />
    <Compile Include="AiExtractPack.fs" />
    <Compile Include="RunAgentActor.fs" />
    <Compile Include="Core\CoreMsg.fs" />
    <Compile Include="Core\CoreEventDispatch.fs" />
    <Compile Include="Core\CoreMailboxBackend.fs" />
    <Compile Include="Core\MailboxHost.fs" />
    <Compile Include="Core\FileAgent.fs" />
    <Compile Include="Database.fs" />
    <Compile Include="DatabaseProjection.fs" />
    <Compile Include="Core\DbAgent.fs" />
    <Compile Include="Core\CoreMailbox.fs" />
    <Compile Include="DatabaseSetup.fs" />
    <Compile Include="SavePrep.fs" />
    <Compile Include="Core\CoreRuntime.fs" />
    <Compile Include="GraphOnlyChangePost.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="LazyLoadReconciliationServer.fs" />
    <Compile Include="HeadPresence.fs" />
    <Compile Include="BrowserRequestCreds.fs" />
    <Compile Include="RouteTypes.fs" />
    <Compile Include="GitGateway.fs" />
    <Compile Include="RouteAuthentication.fs" />
    <Compile Include="RouteAppShell.fs" />
    <Compile Include="RouteRegistration.fs" />
    <Compile Include="ConfigurationOrder.fs" />
    <Compile Include="Server.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Gambol.Shared.fsproj" />
    <ProjectReference Include="..\Shared\dotnet\Gambol.Shared.DotNet.fsproj" />
    <ProjectReference Include="..\CloudAgents\Gambol.CloudAgents.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Thoth.Json.Newtonsoft" Version="0.3.3" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

</Project>
