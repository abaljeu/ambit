<Project Sdk="Microsoft.NET.Sdk">
<!--only files that are exclusively for dotnet and not fable -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DesktopGit.fs" />
    <Compile Include="OutlineLcs.fs" />
    <Compile Include="DocumentParseOps.fs" />
    <Compile Include="ImportDocument.fs" />
    <Compile Include="DocumentAssembly.fs" />
    <Compile Include="LazyLoadReconciliationPath.fs" />
    <Compile Include="LazyLoadReconciliationApply.fs" />
    <Compile Include="LazyLoadReconciliation.fs" />
    <Compile Include="LazyLoadReconciliationReport.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gambol.Shared.fsproj" />
    <ProjectReference Include="..\documents\Gambol.Shared.Documents.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.7.2" />
  </ItemGroup>

</Project>
